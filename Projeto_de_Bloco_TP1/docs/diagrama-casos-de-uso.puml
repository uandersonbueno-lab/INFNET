@startuml
' Sistema de Gestão de Biblioteca Universitária — Diagrama de Casos de Uso
' Uanderson Bueno — 26E4_5 Projeto de Bloco — TP1
left to right direction
skinparam packageStyle rectangle

actor "Membro\n(aluno, professor,\nfuncionário)" as Membro
actor "Bibliotecário /\nAdministrador" as Bib

rectangle "Sistema de Gestão de Biblioteca Universitária" {
  usecase "UC01\nConsultar acervo e disponibilidade" as UC01
  usecase "UC02\nRealizar empréstimo" as UC02
  usecase "UC03\nRegistrar devolução" as UC03
  usecase "UC04\nRealizar reserva" as UC04
  usecase "UC05\nGerenciar acervo" as UC05
  usecase "UC06\nGerenciar membros" as UC06
  usecase "UC07\nGerenciar multas" as UC07
  usecase "UC08\nValidar membro e exemplar" as UC08
  usecase "UC09\nCalcular multa por atraso" as UC09
  usecase "UC10\nVerificar exemplares emprestados" as UC10
}

Membro --> UC01
Membro --> UC02
Membro --> UC03
Membro --> UC04

Bib --> UC01
Bib --> UC02
Bib --> UC03
Bib --> UC04
Bib --> UC05
Bib --> UC06
Bib --> UC07

UC02 ..> UC08 : <<include>>
UC09 ..> UC03 : <<extend>>\n[devolução após o prazo]
UC04 ..> UC10 : <<include>>
@enduml
